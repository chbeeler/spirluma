			.note-two::after { bottom: 100%; height: 10cqw; }
			.visual-caption { position: absolute; right: -10px; bottom: 6%; margin: 0; writing-mode: vertical-rl; transform: translateX(100%); color: var(--muted); font-size: .65rem; letter-spacing: .18em; text-transform: uppercase; }
			.scroll-cue { position: absolute; left: max(24px, calc((100vw - 1220px) / 2)); bottom: 40px; display: flex; gap: 22px; align-items: center; color: var(--muted); font-size: .65rem; letter-spacing: .18em; text-transform: uppercase; }

			.section-shell { width: var(--shell); margin-inline: auto; }
