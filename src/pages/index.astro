			.hero-frame { position: relative; container-type: inline-size; overflow: hidden; border-radius: 28px; border: 1px solid rgba(255,255,255,.08); box-shadow: 0 40px 100px rgba(0,0,0,.45); }
			.hero-frame img { display: block; width: 100%; height: auto; }
			.hero-frame-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(15,15,16,.18), transparent 45%, rgba(15,15,16,.18)); pointer-events: none; }
			.product-note { position: absolute; display: flex; align-items: center; gap: 8px; padding: 6px 12px 6px 6px; border: 1px solid rgba(255,255,255,.2); border-radius: 99px; background: rgba(15,15,16,.88); color: var(--text); font-size: clamp(.55rem, 2cqw, .65rem); letter-spacing: .1em; white-space: nowrap; text-transform: uppercase; }
			.product-note span { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; border: 1px solid rgba(255,255,255,.18); color: var(--gold); }
