			.effect-demo { position: relative; display: grid; place-items: center; min-height: 590px; overflow: hidden; background: radial-gradient(circle, #302719 0, #181716 44%, #121213 72%); }
			.demo-spiral { position: relative; z-index: 2; width: min(60%, 370px); overflow: visible; }
			.demo-spiral path, .contact-spiral path { fill: none; stroke: var(--gold); stroke-linecap: round; stroke-linejoin: round; stroke-dashoffset: 0; transition: stroke-width .55s ease, filter .55s ease, stroke-dashoffset .85s ease; }
			.demo-spiral > path:not(.spiral-track):not(.spiral-light) { display: none; }
