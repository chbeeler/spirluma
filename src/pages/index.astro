---
import { Image } from 'astro:assets';
import productImage from '../assets/spirluma-product.jpeg';
import danceImage from '../assets/spirluma-dance.jpeg';
import friendsImage from '../assets/spirluma-friends.jpeg';
import videoPoster from '../assets/spirluma-video-poster.jpg';

const pageTitle = 'Spirluma — Wear the glow';
const pageDescription = 'Spirluma is a glowing LED filament necklace made for nights that deserve their own light.';

// Scale the Fusion 360 spiral proportionally into the 300 × 300 SVG viewBox.
const spiralTurns = 4.6;
const fusionInnerRadius = 1.95 / 2;
const fusionPitch = 3;
const fusionSectionSize = 1.75;
const svgOuterRadius = 105;
const svgScale = svgOuterRadius / (fusionInnerRadius + spiralTurns * fusionPitch);
const svgInnerRadius = fusionInnerRadius * svgScale;
const svgFilamentWidth = fusionSectionSize * svgScale;
const spiralPath = Array.from({ length: 261 }, (_, index) => {
	const progress = index / 260;
	const angle = -Math.PI / 2 + progress * spiralTurns * Math.PI * 2;
	const radius = svgOuterRadius - progress * (svgOuterRadius - svgInnerRadius);
	const x = 150 + radius * Math.cos(angle);
	const y = 150 + radius * Math.sin(angle);
	return `${index === 0 ? 'M' : 'L'}${x.toFixed(2)} ${y.toFixed(2)}`;
}).join(' ');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={pageDescription} />
		<meta name="theme-color" content="#0F0F10" />
		<meta name="color-scheme" content="dark" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>{pageTitle}</title>
		<script is:inline>document.documentElement.classList.add('js');</script>
	</head>
	<body>
		<header class="site-header" data-header>
			<a class="brand" href="#top" aria-label="Spirluma home">
				<svg class="brand-mark" viewBox="0 0 48 48" aria-hidden="true">
					<path d="M35.7 12.2C29.2 5.7 18.6 5.7 12.1 12.3s-6.5 17.1.1 23.6 17.2 6.5 23.7-.1 6.5-17.2-.1-23.7-14-6.5-20.5.1-6.5 14 .1 20.5 10.7 4.1 14.8-.1 4.1-10.7-.1-14.8-7.5-3-10.5 0-3 7.5 0 10.5 4.3 1.9 6.2-.1 1.9-4.3-.1-6.2" />
				</svg>
				<span>SPIRLUMA</span>
			</a>

			<button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
				<span class="sr-only">Toggle menu</span>
				<span></span><span></span>
			</button>

			<nav id="site-nav" class="site-nav" aria-label="Main navigation">
				<a href="#story">The glow</a>
				<a href="#gallery">In the wild</a>
				<a href="#contact">Say hello</a>
			</nav>
		</header>

		<main id="top">
			<section class="hero" aria-labelledby="hero-title">
				<div class="hero-copy reveal">
					<p class="eyebrow"><span class="eyebrow-dot"></span> A little sun for after dark</p>
					<h1 id="hero-title">Wear the<br /><em>glow.</em></h1>
					<p class="hero-intro">A luminous spiral for dance floors, midnight walks and every beautifully strange place in between.</p>
					<div class="hero-actions">
						<a class="button button-primary" href="#gallery">See it shine <span aria-hidden="true">↘</span></a>
						<a class="text-link" href="#story">Discover Spirluma <span aria-hidden="true">→</span></a>
					</div>
				</div>

				<div class="hero-visual reveal" style="--delay: 120ms">
					<div class="orbit orbit-one"></div>
					<div class="orbit orbit-two"></div>
					<div class="hero-frame">
						<Image src={productImage} alt="Spirluma's glowing spiral pendant on a dark surface" widths={[560, 900, 1200]} sizes="(max-width: 720px) 92vw, 50vw" loading="eager" fetchpriority="high" quality={82} />
						<div class="hero-frame-shade"></div>
						<div class="product-note note-one"><span>01</span> LED filament</div>
						<div class="product-note note-two"><span>02</span> Spiral form</div>
					</div>
					<p class="visual-caption">Light, in its favorite shape.</p>
				</div>

				<a class="scroll-cue" href="#story" aria-label="Scroll to the story">
					<span>Scroll to glow</span><span aria-hidden="true">↓</span>
				</a>
			</section>

			<section class="manifesto section-shell" id="story" aria-labelledby="manifesto-title">
				<div class="section-number" aria-hidden="true">01 / THE IDEA</div>
				<div class="manifesto-copy reveal">
					<p class="eyebrow">A small object. A big aura.</p>
					<h2 id="manifesto-title">Made to be <span>noticed</span>.<br />Designed to feel <span>easy</span>.</h2>
				</div>
				<p class="manifesto-body reveal" style="--delay: 100ms">Spirluma turns one continuous line of warm light into a wearable focal point. The compact black body disappears into the night, leaving the spiral to do what it does best: pull people in.</p>
			</section>

			<section class="effect-section section-shell" aria-labelledby="effect-title">
				<div class="effect-card reveal">
					<div class="effect-demo" data-effect-demo data-mode="form">
						<div class="demo-halo halo-three"></div>
						<div class="demo-halo halo-two"></div>
						<div class="demo-halo halo-one"></div>
						<svg class="demo-spiral" viewBox="0 0 300 300" style={`--filament-width: ${svgFilamentWidth.toFixed(2)}`} aria-label="A glowing spiral beginning at the top">
							<path class="spiral-track" pathLength="1000" d={spiralPath} />
							<path class="spiral-light" pathLength="1000" d={spiralPath} />
							<path pathLength="1000" d="M150 150 L150.7 150.1 L151.3 150.5 L151.8 151.2 L152.1 152 L152.1 153 L151.7 154 L151.1 154.9 L150.2 155.8 L148.9 156.4 L147.5 156.8 L145.9 156.8 L144.1 156.4 L142.4 155.6 L140.9 154.3 L139.5 152.7 L138.5 150.7 L137.8 148.4 L137.7 145.8 L138.1 143.2 L139.1 140.6 L140.6 138.1 L142.8 135.9 L145.4 134 L148.5 132.7 L151.9 132 L155.5 132 L159.2 132.8 L162.8 134.3 L166.1 136.6 L169 139.6 L171.3 143.2 L173 147.3 L173.8 151.8 L173.7 156.5 L172.7 161.2 L170.7 165.8 L167.7 170 L163.9 173.7 L159.4 176.6 L154.2 178.6 L148.6 179.6 L142.8 179.5 L137 178.2 L131.4 175.8 L126.3 172.3 L121.9 167.7 L118.3 162.2 L115.9 156.1 L114.6 149.4 L114.7 142.5 L116.1 135.6 L118.9 128.9 L123 122.9 L128.3 117.6 L134.6 113.4 L141.8 110.4 L149.5 108.8 L157.5 108.8 L165.5 110.3 L173.2 113.4 L180.3 118 L186.5 124 L191.4 131.1 L195 139.3 L196.9 148 L197.1 157.2 L195.6 166.3 L192.2 175.1 L187.2 183.2 L180.6 190.3 L172.6 196 L163.6 200.2 L153.8 202.6 L143.5 203.1 L133.3 201.5 L123.3 198 L114.2 192.6 L106.1 185.4 L99.5 176.7 L94.7 166.7 L91.8 155.9 L91 144.5 L92.4 133.1 L96.1 122.1 L101.9 111.9 L109.6 102.8 L119 95.3 L129.8 89.7 L141.7 86.2 L154.1 85.1 L166.6 86.4 L178.8 90.1 L190.2 96.1 L200.3 104.3 L208.7 114.4 L215.1 126.1 L219.2 138.9 L220.8 152.4 L219.7 166 L216 179.4 L209.8 191.9 L201.1 203.1 L190.4 212.5 L178 219.8 L164.2 224.5 L149.7 226.6 L134.9 225.8 L120.4 222.2 L106.7 215.8 L94.4 206.8 L83.9 195.5 L75.8 182.3 L70.3 167.6 L67.7 152.1 L68.1 136.1 L71.6 120.5 L78.1 105.6 L87.4 92.2 L99.2 80.6 L113.1 71.5 L128.6 65.2 L145.2 62 L162.2 62 L179.1 65.3 L195.2 71.8 L209.8 81.3 L222.4 93.6 L232.5 108.2 L239.7 124.6 L243.6 142.1 L244.1 160.3 L241.1 178.3 L234.6 195.6 L224.9 211.4 L212.2 225.2 L197 236.3 L179.8 244.4 L161.3 249.1 L142 250.1 L122.8 247.4 L104.3 241.1 L87.3 231.2 L72.4 218.2 L60.1 202.4 L51.1 184.5 L45.6 165 L43.9 144.7 L46.2 124.3 L52.4 104.6 L62.3 86.3" />
						</svg>
						<span class="demo-label">LIGHT STUDY</span>
					</div>

					<div class="effect-copy">
						<p class="eyebrow">How the light works</p>
						<h2 id="effect-title">A line becomes<br />a <em>halo.</em></h2>
						<p id="effect-description">Starting at twelve o’clock, the filament follows an evenly pitched spiral before opening into a softer inner curl.</p>

						<div class="effect-tabs" role="tablist" aria-label="Explore the light design">
							<button class="effect-tab is-active" type="button" role="tab" aria-selected="true" data-mode="form">01 <span>Form</span></button>
							<button class="effect-tab" type="button" role="tab" aria-selected="false" data-mode="filament">02 <span>Filament</span></button>
							<button class="effect-tab" type="button" role="tab" aria-selected="false" data-mode="halo">03 <span>Halo</span></button>
						</div>
					</div>
				</div>
			</section>

			<section class="gallery-section section-shell" id="gallery" aria-labelledby="gallery-title">
				<div class="gallery-heading reveal">
					<div>
						<div class="section-number" aria-hidden="true">02 / IN THE WILD</div>
						<h2 id="gallery-title">Find your people.<br /><em>Keep your glow.</em></h2>
					</div>
					<p>From first beat to last call, Spirluma adds a warm point of light to the beautiful blur.</p>
				</div>

				<div class="gallery-grid">
					<figure class="gallery-item gallery-main reveal">
						<Image src={danceImage} alt="Woman dancing at a colorful night event while wearing a glowing Spirluma necklace" widths={[620, 980, 1400]} sizes="(max-width: 720px) 100vw, 58vw" quality={82} />
						<figcaption><span>After dark</span><span>01</span></figcaption>
					</figure>

					<div class="gallery-side">
						<figure class="gallery-item reveal" style="--delay: 80ms">
							<Image src={friendsImage} alt="Two friends wearing glowing Spirluma necklaces at a night market" widths={[500, 760, 1000]} sizes="(max-width: 720px) 100vw, 38vw" quality={82} />
							<figcaption><span>Better together</span><span>02</span></figcaption>
						</figure>
						<figure class="gallery-item video-item reveal" style="--delay: 140ms">
							<Image class="video-poster" src={videoPoster} alt="Spirluma pendant ready to light up" widths={[500, 760]} sizes="(max-width: 720px) 100vw, 38vw" quality={80} />
							<video class="gallery-video" muted loop playsinline preload="none" aria-label="Spirluma in motion at night" data-lazy-video>
								<source data-src="/media/spirluma-glow.mp4" type="video/mp4" />
							</video>
							<button class="video-toggle" type="button" aria-label="Play video"><span class="play-icon" aria-hidden="true">▶</span><span class="pause-icon" aria-hidden="true">Ⅱ</span></button>
							<figcaption><span>See it move</span><span>03</span></figcaption>
						</figure>
					</div>
				</div>
			</section>

			<section class="specs-section section-shell" aria-labelledby="specs-title">
				<div class="specs-heading reveal">
					<div>
						<div class="section-number" aria-hidden="true">03 / THE DETAILS</div>
						<h2 id="specs-title">Small circle.<br /><em>Serious energy.</em></h2>
					</div>
					<p>Everything Spirluma needs for a full night out, packed into one playful little object.</p>
				</div>

				<div class="specs-grid">
					<article class="spec-card spec-card-wide reveal">
						<div class="sound-wave" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>
						<div><p>Music reactive</p><h3>Moves with<br />the beat.</h3></div>
						<span class="spec-index">01</span>
					</article>
					<article class="spec-card spec-runtime reveal" style="--delay: 60ms">
						<p>Battery powered</p><strong>6 – 8<small>h</small></strong><span>on one charge</span>
						<span class="spec-index">02</span>
					</article>
					<article class="spec-card reveal" style="--delay: 90ms">
						<span class="spec-symbol" aria-hidden="true">↯</span><p>USB-C</p><h3>Simple<br />charging.</h3><span class="spec-index">03</span>
					</article>
					<article class="spec-card reveal" style="--delay: 120ms">
						<span class="spec-symbol" aria-hidden="true">◌</span><p>Configurable Brightness</p><h3>Set your<br />own glow.</h3><span class="spec-index">04</span>
					</article>
					<article class="spec-card reveal" style="--delay: 150ms">
						<span class="spec-symbol" aria-hidden="true">⌁</span><p>3D printed</p><h3>A case with<br />character.</h3><span class="spec-index">05</span>
					</article>
				</div>
			</section>

			<section class="contact-section section-shell" id="contact" aria-labelledby="contact-title">
				<div class="contact-glow" aria-hidden="true"></div>
				<div class="contact-content reveal">
					<p class="eyebrow">Let’s make some light</p>
					<h2 id="contact-title">Curious about<br /><em>Spirluma?</em></h2>
					<p>Questions, collaborations, festival plans—start a conversation and tell us where you’d wear yours.</p>
					<a class="button button-primary button-large" href="mailto:?subject=Hello%20Spirluma">Start an email <span aria-hidden="true">↗</span></a>
				</div>
				<svg class="contact-spiral" viewBox="0 0 400 400" aria-hidden="true">
					<path d="M300 100c-55-55-145-55-200 0s-55 145 0 200 145 55 200 0 55-145 0-200-118-55-173 0-55 118 0 173 93 38 131 0 38-93 0-131-69-29-98 0-29 69 0 98 45 20 65 0 20-45 0-65-24-12-36 0-12 24 0 36 14 6 20 0" />
				</svg>
			</section>
		</main>

		<footer class="site-footer section-shell">
			<a class="brand" href="#top" aria-label="Back to top">
				<svg class="brand-mark" viewBox="0 0 48 48" aria-hidden="true"><path d="M35.7 12.2C29.2 5.7 18.6 5.7 12.1 12.3s-6.5 17.1.1 23.6 17.2 6.5 23.7-.1 6.5-17.2-.1-23.7-14-6.5-20.5.1-6.5 14 .1 20.5 10.7 4.1 14.8-.1 4.1-10.7-.1-14.8-7.5-3-10.5 0-3 7.5 0 10.5 4.3 1.9 6.2-.1 1.9-4.3-.1-6.2" /></svg>
				<span>SPIRLUMA</span>
			</a>
			<p>Light follows you.</p>
			<p class="copyright">© {new Date().getFullYear()} Spirluma</p>
		</footer>

		<script>
			const menuButton = document.querySelector('.menu-toggle');
			const nav = document.querySelector('.site-nav');
			menuButton?.addEventListener('click', () => {
				const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
				menuButton.setAttribute('aria-expanded', String(!isOpen));
				nav?.classList.toggle('is-open', !isOpen);
			});
			nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
				menuButton?.setAttribute('aria-expanded', 'false');
				nav.classList.remove('is-open');
			}));

			const copy = {
				form: 'Starting at twelve o’clock, the filament follows an evenly pitched spiral before opening into a softer inner curl.',
				filament: 'One continuous luminous line follows the full spiral, keeping the surface clean and expressive—more like a piece of drawn light than a tiny screen.',
				halo: 'Light spills softly past the edge of the pendant, creating a golden aura that feels warmer and more organic than a hard point of light.'
			};
			const demo = document.querySelector('[data-effect-demo]');
			const description = document.querySelector('#effect-description');
			document.querySelectorAll('.effect-tab').forEach((tab) => {
				tab.addEventListener('click', () => {
					const mode = tab.getAttribute('data-mode') ?? 'form';
					document.querySelectorAll('.effect-tab').forEach((item) => {
						item.classList.toggle('is-active', item === tab);
						item.setAttribute('aria-selected', String(item === tab));
					});
					if (demo instanceof HTMLElement) demo.dataset.mode = mode;
					if (description) description.textContent = copy[mode as keyof typeof copy];
				});
			});

			const video = document.querySelector('[data-lazy-video]');
			const videoButton = document.querySelector('.video-toggle');
			if (video instanceof HTMLVideoElement && videoButton instanceof HTMLButtonElement) {
				let videoLoaded = false;
				const loadVideo = () => {
					if (videoLoaded) return;
					video.querySelectorAll('source[data-src]').forEach((source) => {
						if (source instanceof HTMLSourceElement && source.dataset.src) source.src = source.dataset.src;
					});
					videoLoaded = true;
					video.load();
				};
				new IntersectionObserver((entries, observer) => {
					if (entries[0]?.isIntersecting) { loadVideo(); observer.disconnect(); }
				}, { rootMargin: '200px' }).observe(video);
				video.addEventListener('loadeddata', () => video.classList.add('is-ready'));
				videoButton.addEventListener('click', async () => {
					if (video.paused) {
						loadVideo();
						try { await video.play(); videoButton.classList.add('is-playing'); videoButton.setAttribute('aria-label', 'Pause video'); }
						catch { videoButton.setAttribute('aria-label', 'This video format is not supported by your browser'); }
					}
					else { video.pause(); videoButton.classList.remove('is-playing'); videoButton.setAttribute('aria-label', 'Play video'); }
				});
			}

			const revealObserver = new IntersectionObserver((entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) { entry.target.classList.add('is-visible'); revealObserver.unobserve(entry.target); }
				});
			}, { threshold: 0.12 });
			document.querySelectorAll('.reveal').forEach((element) => revealObserver.observe(element));
		</script>

		<style is:global>
			:root {
				--bg: #0f0f10;
				--surface: #232324;
				--surface-raised: #2d2d30;
				--accent: #a36d1c;
				--gold: #ffc642;
				--gold-light: #ffe09a;
				--text: #fff;
				--text-soft: #e6e6e6;
				--muted: #99999e;
				--outline: #3a3a3c;
				--track: #2c2c2e;
				--shell: min(1220px, calc(100vw - 48px));
				--radius: 28px;
			}

			* { box-sizing: border-box; }
			html { scroll-behavior: smooth; background: var(--bg); }
			body {
				margin: 0;
				background: var(--bg);
				color: var(--text);
				font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
				line-height: 1.5;
				overflow-x: hidden;
			}
			body::before {
				content: '';
				position: fixed;
				inset: 0;
				pointer-events: none;
				opacity: .035;
				z-index: 20;
				background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.7'/%3E%3C/svg%3E");
			}
			a { color: inherit; text-decoration: none; }
			button { font: inherit; }
			img, video { display: block; width: 100%; }
			::selection { background: var(--gold); color: #000; }
			.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }

			.site-header {
				position: absolute;
				top: 0;
				left: 50%;
				transform: translateX(-50%);
				width: var(--shell);
				height: 92px;
				display: flex;
				align-items: center;
				justify-content: space-between;
				z-index: 10;
			}
			.brand { display: inline-flex; align-items: center; gap: 11px; font-size: .82rem; font-weight: 800; letter-spacing: .22em; }
			.brand-mark { width: 28px; height: 28px; fill: none; stroke: var(--gold); stroke-width: 2.8; stroke-linecap: round; filter: drop-shadow(0 0 6px rgba(255,198,66,.55)); }
			.site-nav { display: flex; align-items: center; gap: 34px; }
			.site-nav a { color: var(--text-soft); font-size: .76rem; letter-spacing: .12em; text-transform: uppercase; transition: color .2s ease; }
			.site-nav a:hover, .site-nav a:focus-visible { color: var(--gold); }
			.menu-toggle { display: none; }

			.hero {
				position: relative;
				min-height: 780px;
				height: min(940px, 100svh);
				padding: 130px max(24px, calc((100vw - 1220px) / 2)) 70px;
				display: grid;
				grid-template-columns: .9fr 1.1fr;
				align-items: center;
				gap: 6vw;
				isolation: isolate;
			}
			.hero::before {
				content: '';
				position: absolute;
				inset: 0 0 auto auto;
				width: 62vw;
				height: 100%;
				background: radial-gradient(circle at 58% 43%, rgba(255,187,46,.16), transparent 27%), linear-gradient(135deg, transparent 20%, rgba(255,255,255,.025));
				z-index: -1;
			}
			.hero-copy { position: relative; z-index: 2; padding-bottom: 7vh; }
			.eyebrow { margin: 0 0 24px; color: var(--gold-light); font-size: .71rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; }
			.eyebrow-dot { display: inline-block; width: 7px; height: 7px; margin-right: 9px; border-radius: 50%; background: var(--gold); box-shadow: 0 0 14px var(--gold); }
			h1, h2 { margin: 0; font-weight: 700; letter-spacing: -.065em; line-height: .88; }
			h1 { max-width: 690px; font-size: clamp(5rem, 8.5vw, 9rem); }
			h1 em, h2 em { color: var(--gold); font-family: Georgia, 'Times New Roman', serif; font-weight: 400; }
			.hero-intro { max-width: 490px; margin: 34px 0 0; color: var(--text-soft); font-size: clamp(1.05rem, 1.35vw, 1.28rem); line-height: 1.65; }
			.hero-actions { display: flex; align-items: center; gap: 28px; margin-top: 38px; }
			.button { min-height: 54px; padding: 0 22px; display: inline-flex; align-items: center; justify-content: center; gap: 24px; border: 1px solid transparent; border-radius: 99px; font-size: .77rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; transition: transform .25s ease, box-shadow .25s ease, background .25s ease; }
			.button-primary { background: var(--gold); color: #000; box-shadow: 0 0 0 rgba(255,198,66,0); }
			.button-primary:hover, .button-primary:focus-visible { transform: translateY(-2px); box-shadow: 0 10px 36px rgba(255,198,66,.2); background: #ffd264; }
			.text-link { display: inline-flex; gap: 16px; font-size: .77rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; border-bottom: 1px solid var(--outline); padding: 12px 0; }
