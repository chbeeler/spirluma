			.contact-section { position: relative; min-height: 680px; margin-bottom: 28px; padding: clamp(42px, 6vw, 82px); overflow: hidden; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--outline); isolation: isolate; }
