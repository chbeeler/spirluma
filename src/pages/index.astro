---
import { Image } from 'astro:assets';
import productImage from '../assets/spirluma-product.jpeg';
import danceImage from '../assets/spirluma-dance.jpeg';
import friendsImage from '../assets/spirluma-friends.jpeg';

const pageTitle = 'Spirluma — Wear the glow';
const pageDescription = 'Spirluma is a glowing LED filament necklace made for nights that deserve their own light.';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={pageDescription} />
		<meta name="theme-color" content="#0F0F10" />
		<meta name="color-scheme" content="dark" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>{pageTitle}</title>
		<script is:inline>document.documentElement.classList.add('js');</script>
	</head>
	<body>
		<header class="site-header" data-header>
			<a class="brand" href="#top" aria-label="Spirluma home">
				<svg class="brand-mark" viewBox="0 0 48 48" aria-hidden="true">
					<path d="M35.7 12.2C29.2 5.7 18.6 5.7 12.1 12.3s-6.5 17.1.1 23.6 17.2 6.5 23.7-.1 6.5-17.2-.1-23.7-14-6.5-20.5.1-6.5 14 .1 20.5 10.7 4.1 14.8-.1 4.1-10.7-.1-14.8-7.5-3-10.5 0-3 7.5 0 10.5 4.3 1.9 6.2-.1 1.9-4.3-.1-6.2" />
				</svg>
				<span>SPIRLUMA</span>
			</a>

			<button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
				<span class="sr-only">Toggle menu</span>
				<span></span><span></span>
			</button>

			<nav id="site-nav" class="site-nav" aria-label="Main navigation">
				<a href="#story">The glow</a>
				<a href="#gallery">In the wild</a>
				<a href="#contact">Say hello</a>
			</nav>
		</header>

		<main id="top">
			<section class="hero" aria-labelledby="hero-title">
				<div class="hero-copy reveal">
					<p class="eyebrow"><span class="eyebrow-dot"></span> A little sun for after dark</p>
					<h1 id="hero-title">Wear the<br /><em>glow.</em></h1>
					<p class="hero-intro">A luminous spiral for dance floors, midnight walks and every beautifully strange place in between.</p>
					<div class="hero-actions">
						<a class="button button-primary" href="#gallery">See it shine <span aria-hidden="true">↘</span></a>
						<a class="text-link" href="#story">Discover Spirluma <span aria-hidden="true">→</span></a>
					</div>
				</div>

				<div class="hero-visual reveal" style="--delay: 120ms">
					<div class="orbit orbit-one"></div>
					<div class="orbit orbit-two"></div>
					<div class="hero-frame">
						<Image src={productImage} alt="Spirluma's glowing spiral pendant on a dark surface" widths={[560, 900, 1200]} sizes="(max-width: 720px) 92vw, 50vw" loading="eager" fetchpriority="high" quality={82} />
						<div class="hero-frame-shade"></div>
						<div class="product-note note-one"><span>01</span> LED filament</div>
						<div class="product-note note-two"><span>02</span> Spiral form</div>
					</div>
					<p class="visual-caption">Light, in its favorite shape.</p>
				</div>

				<a class="scroll-cue" href="#story" aria-label="Scroll to the story">
					<span>Scroll to glow</span><span aria-hidden="true">↓</span>
				</a>
			</section>

			<section class="manifesto section-shell" id="story" aria-labelledby="manifesto-title">
				<div class="section-number" aria-hidden="true">01 / THE IDEA</div>
				<div class="manifesto-copy reveal">
					<p class="eyebrow">A small object. A big aura.</p>
					<h2 id="manifesto-title">Made to be <span>noticed</span>.<br />Designed to feel <span>easy</span>.</h2>
				</div>
				<p class="manifesto-body reveal" style="--delay: 100ms">Spirluma turns one continuous line of warm light into a wearable focal point. The compact black body disappears into the night, leaving the spiral to do what it does best: pull people in.</p>
			</section>

			<section class="effect-section section-shell" aria-labelledby="effect-title">
				<div class="effect-card reveal">
					<div class="effect-demo" data-effect-demo data-mode="form">
						<div class="demo-halo halo-three"></div>
						<div class="demo-halo halo-two"></div>
						<div class="demo-halo halo-one"></div>
						<svg class="demo-spiral" viewBox="0 0 300 300" aria-label="Illustration of the Spirluma light spiral">
							<path d="M223 69c-40-40-105-40-145 0s-40 105 0 145 105 40 145 0 40-105 0-145-86-40-126 0-40 86 0 126 68 28 96 0 28-68 0-96-50-21-71 0-21 50 0 71 32 14 46 0 14-32 0-46-16-8-24 0-8 16 0 24 10 4 14 0" />
						</svg>
						<span class="demo-label">LIGHT STUDY / 01</span>
					</div>

					<div class="effect-copy">
						<p class="eyebrow">How the light works</p>
						<h2 id="effect-title">A line becomes<br />a <em>halo.</em></h2>
						<p id="effect-description">The filament follows a tight, inward curve, layering its warm glow into a graphic spiral that reads from across the room.</p>

						<div class="effect-tabs" role="tablist" aria-label="Explore the light design">
							<button class="effect-tab is-active" type="button" role="tab" aria-selected="true" data-mode="form">01 <span>Form</span></button>
							<button class="effect-tab" type="button" role="tab" aria-selected="false" data-mode="filament">02 <span>Filament</span></button>
							<button class="effect-tab" type="button" role="tab" aria-selected="false" data-mode="halo">03 <span>Halo</span></button>
						</div>
					</div>
				</div>
			</section>

			<section class="gallery-section section-shell" id="gallery" aria-labelledby="gallery-title">
				<div class="gallery-heading reveal">
					<div>
						<div class="section-number" aria-hidden="true">02 / IN THE WILD</div>
						<h2 id="gallery-title">Find your people.<br /><em>Keep your glow.</em></h2>
					</div>
					<p>From first beat to last call, Spirluma adds a warm point of light to the beautiful blur.</p>
				</div>

				<div class="gallery-grid">
					<figure class="gallery-item gallery-main reveal">
						<Image src={danceImage} alt="Woman dancing at a colorful night event while wearing a glowing Spirluma necklace" widths={[620, 980, 1400]} sizes="(max-width: 720px) 100vw, 58vw" quality={82} />
						<figcaption><span>After dark</span><span>01</span></figcaption>
					</figure>

					<div class="gallery-side">
						<figure class="gallery-item reveal" style="--delay: 80ms">
							<Image src={friendsImage} alt="Two friends wearing glowing Spirluma necklaces at a night market" widths={[500, 760, 1000]} sizes="(max-width: 720px) 100vw, 38vw" quality={82} />
							<figcaption><span>Better together</span><span>02</span></figcaption>
						</figure>
						<figure class="gallery-item video-item reveal" style="--delay: 140ms">
							<Image class="video-poster" src={danceImage} alt="" widths={[500, 760]} sizes="(max-width: 720px) 100vw, 38vw" quality={78} />
							<video class="gallery-video" muted loop playsinline preload="none" aria-label="Spirluma in motion at night" data-lazy-video>
								<source data-src="/media/spirluma-in-motion.MOV" type="video/quicktime" />
							</video>
							<button class="video-toggle" type="button" aria-label="Play video"><span class="play-icon" aria-hidden="true">▶</span><span class="pause-icon" aria-hidden="true">Ⅱ</span></button>
							<figcaption><span>See it move</span><span>03</span></figcaption>
						</figure>
					</div>
				</div>
			</section>

			<section class="contact-section section-shell" id="contact" aria-labelledby="contact-title">
				<div class="contact-glow" aria-hidden="true"></div>
				<div class="contact-content reveal">
					<p class="eyebrow">Let’s make some light</p>
					<h2 id="contact-title">Curious about<br /><em>Spirluma?</em></h2>
					<p>Questions, collaborations, festival plans—start a conversation and tell us where you’d wear yours.</p>
					<a class="button button-primary button-large" href="mailto:?subject=Hello%20Spirluma">Start an email <span aria-hidden="true">↗</span></a>
				</div>
				<svg class="contact-spiral" viewBox="0 0 400 400" aria-hidden="true">
					<path d="M300 100c-55-55-145-55-200 0s-55 145 0 200 145 55 200 0 55-145 0-200-118-55-173 0-55 118 0 173 93 38 131 0 38-93 0-131-69-29-98 0-29 69 0 98 45 20 65 0 20-45 0-65-24-12-36 0-12 24 0 36 14 6 20 0" />
				</svg>
			</section>
		</main>

		<footer class="site-footer section-shell">
			<a class="brand" href="#top" aria-label="Back to top">
				<svg class="brand-mark" viewBox="0 0 48 48" aria-hidden="true"><path d="M35.7 12.2C29.2 5.7 18.6 5.7 12.1 12.3s-6.5 17.1.1 23.6 17.2 6.5 23.7-.1 6.5-17.2-.1-23.7-14-6.5-20.5.1-6.5 14 .1 20.5 10.7 4.1 14.8-.1 4.1-10.7-.1-14.8-7.5-3-10.5 0-3 7.5 0 10.5 4.3 1.9 6.2-.1 1.9-4.3-.1-6.2" /></svg>
				<span>SPIRLUMA</span>
			</a>
			<p>Light follows you.</p>
			<p class="copyright">© {new Date().getFullYear()} Spirluma</p>
		</footer>

		<script>
			const menuButton = document.querySelector('.menu-toggle');
			const nav = document.querySelector('.site-nav');
			menuButton?.addEventListener('click', () => {
				const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
				menuButton.setAttribute('aria-expanded', String(!isOpen));
				nav?.classList.toggle('is-open', !isOpen);
			});
			nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
				menuButton?.setAttribute('aria-expanded', 'false');
				nav.classList.remove('is-open');
			}));

			const copy = {
				form: 'The filament follows a tight, inward curve, layering its warm glow into a graphic spiral that reads from across the room.',
				filament: 'A continuous luminous line keeps the surface clean and expressive—less like a tiny screen, more like a piece of drawn light.',
				halo: 'Light spills softly past the edge of the pendant, creating a golden aura that feels warmer and more organic than a hard point of light.'
			};
			const demo = document.querySelector('[data-effect-demo]');
			const description = document.querySelector('#effect-description');
			document.querySelectorAll('.effect-tab').forEach((tab) => {
				tab.addEventListener('click', () => {
					const mode = tab.getAttribute('data-mode') ?? 'form';
					document.querySelectorAll('.effect-tab').forEach((item) => {
						item.classList.toggle('is-active', item === tab);
						item.setAttribute('aria-selected', String(item === tab));
					});
					if (demo instanceof HTMLElement) demo.dataset.mode = mode;
					if (description) description.textContent = copy[mode as keyof typeof copy];
				});
			});

			const video = document.querySelector('[data-lazy-video]');
			const videoButton = document.querySelector('.video-toggle');
			if (video instanceof HTMLVideoElement && videoButton instanceof HTMLButtonElement) {
				const loadVideo = () => {
					video.querySelectorAll('source[data-src]').forEach((source) => {
						if (source instanceof HTMLSourceElement && source.dataset.src) source.src = source.dataset.src;
					});
					video.load();
				};
				new IntersectionObserver((entries, observer) => {
					if (entries[0]?.isIntersecting) { loadVideo(); observer.disconnect(); }
				}, { rootMargin: '200px' }).observe(video);
				video.addEventListener('loadeddata', () => video.classList.add('is-ready'));
				videoButton.addEventListener('click', async () => {
					if (video.paused) {
						try { await video.play(); videoButton.classList.add('is-playing'); videoButton.setAttribute('aria-label', 'Pause video'); }
						catch { videoButton.setAttribute('aria-label', 'This video format is not supported by your browser'); }
					}
					else { video.pause(); videoButton.classList.remove('is-playing'); videoButton.setAttribute('aria-label', 'Play video'); }
				});
			}

			const revealObserver = new IntersectionObserver((entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) { entry.target.classList.add('is-visible'); revealObserver.unobserve(entry.target); }
				});
			}, { threshold: 0.12 });
			document.querySelectorAll('.reveal').forEach((element) => revealObserver.observe(element));
		</script>

		<style is:global>
			:root {
				--bg: #0f0f10;
				--surface: #232324;
				--surface-raised: #2d2d30;
				--accent: #a36d1c;
				--gold: #ffc642;
				--gold-light: #ffe09a;
				--text: #fff;
				--text-soft: #e6e6e6;
				--muted: #99999e;
				--outline: #3a3a3c;
				--track: #2c2c2e;
				--shell: min(1220px, calc(100vw - 48px));
				--radius: 28px;
			}

			* { box-sizing: border-box; }
			html { scroll-behavior: smooth; background: var(--bg); }
			body {
				margin: 0;
				background: var(--bg);
				color: var(--text);
				font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
				line-height: 1.5;
				overflow-x: hidden;
			}
			body::before {
				content: '';
				position: fixed;
				inset: 0;
				pointer-events: none;
				opacity: .035;
				z-index: 20;
				background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.7'/%3E%3C/svg%3E");
			}
			a { color: inherit; text-decoration: none; }
			button { font: inherit; }
			img, video { display: block; width: 100%; }
			::selection { background: var(--gold); color: #000; }
			.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }

			.site-header {
				position: absolute;
				top: 0;
				left: 50%;
				transform: translateX(-50%);
				width: var(--shell);
				height: 92px;
				display: flex;
				align-items: center;
				justify-content: space-between;
				z-index: 10;
			}
			.brand { display: inline-flex; align-items: center; gap: 11px; font-size: .82rem; font-weight: 800; letter-spacing: .22em; }
			.brand-mark { width: 28px; height: 28px; fill: none; stroke: var(--gold); stroke-width: 2.8; stroke-linecap: round; filter: drop-shadow(0 0 6px rgba(255,198,66,.55)); }
			.site-nav { display: flex; align-items: center; gap: 34px; }
			.site-nav a { color: var(--text-soft); font-size: .76rem; letter-spacing: .12em; text-transform: uppercase; transition: color .2s ease; }
			.site-nav a:hover, .site-nav a:focus-visible { color: var(--gold); }
			.menu-toggle { display: none; }

			.hero {
				position: relative;
				min-height: 780px;
				height: min(940px, 100svh);
				padding: 130px max(24px, calc((100vw - 1220px) / 2)) 70px;
				display: grid;
				grid-template-columns: .9fr 1.1fr;
				align-items: center;
				gap: 6vw;
				isolation: isolate;
			}
			.hero::before {
				content: '';
				position: absolute;
				inset: 0 0 auto auto;
				width: 62vw;
				height: 100%;
				background: radial-gradient(circle at 58% 43%, rgba(255,187,46,.16), transparent 27%), linear-gradient(135deg, transparent 20%, rgba(255,255,255,.025));
				z-index: -1;
			}
			.hero-copy { position: relative; z-index: 2; padding-bottom: 7vh; }
			.eyebrow { margin: 0 0 24px; color: var(--gold-light); font-size: .71rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; }
			.eyebrow-dot { display: inline-block; width: 7px; height: 7px; margin-right: 9px; border-radius: 50%; background: var(--gold); box-shadow: 0 0 14px var(--gold); }
			h1, h2 { margin: 0; font-weight: 700; letter-spacing: -.065em; line-height: .88; }
			h1 { max-width: 690px; font-size: clamp(5rem, 8.5vw, 9rem); }
			h1 em, h2 em { color: var(--gold); font-family: Georgia, 'Times New Roman', serif; font-weight: 400; }
			.hero-intro { max-width: 490px; margin: 34px 0 0; color: var(--text-soft); font-size: clamp(1.05rem, 1.35vw, 1.28rem); line-height: 1.65; }
			.hero-actions { display: flex; align-items: center; gap: 28px; margin-top: 38px; }
			.button { min-height: 54px; padding: 0 22px; display: inline-flex; align-items: center; justify-content: center; gap: 24px; border: 1px solid transparent; border-radius: 99px; font-size: .77rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; transition: transform .25s ease, box-shadow .25s ease, background .25s ease; }
			.button-primary { background: var(--gold); color: #000; box-shadow: 0 0 0 rgba(255,198,66,0); }
			.button-primary:hover, .button-primary:focus-visible { transform: translateY(-2px); box-shadow: 0 10px 36px rgba(255,198,66,.2); background: #ffd264; }
			.text-link { display: inline-flex; gap: 16px; font-size: .77rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; border-bottom: 1px solid var(--outline); padding: 12px 0; }
			.text-link:hover { color: var(--gold); border-color: var(--gold); }

			.hero-visual { position: relative; width: min(50vw, 600px); margin-left: auto; }
			.hero-frame { position: relative; aspect-ratio: .84; overflow: hidden; border-radius: 48% 48% 22% 22% / 34% 34% 16% 16%; border: 1px solid rgba(255,255,255,.08); box-shadow: 0 40px 100px rgba(0,0,0,.45); }
			.hero-frame img { width: 100%; height: 100%; object-fit: cover; object-position: 54% 70%; filter: contrast(1.08) saturate(.78) brightness(.72); transform: scale(1.13); }
			.hero-frame-shade { position: absolute; inset: 0; background: radial-gradient(circle at 52% 66%, rgba(255,182,28,.12), transparent 25%), linear-gradient(180deg, rgba(15,15,16,.1), rgba(15,15,16,.6)); }
			.orbit { position: absolute; border: 1px solid rgba(255,198,66,.2); border-radius: 50%; pointer-events: none; }
			.orbit-one { width: 115%; aspect-ratio: 1; top: -6%; left: -8%; transform: rotate(-12deg); }
			.orbit-two { width: 88%; aspect-ratio: 1; bottom: -9%; right: -18%; border-style: dashed; animation: rotate 28s linear infinite; }
			.product-note { position: absolute; display: flex; align-items: center; gap: 10px; color: var(--text-soft); font-size: .65rem; letter-spacing: .12em; text-transform: uppercase; }
			.product-note span { display: grid; place-items: center; width: 29px; height: 29px; border-radius: 50%; background: rgba(15,15,16,.78); border: 1px solid rgba(255,255,255,.18); color: var(--gold); }
			.note-one { left: 9%; top: 11%; }
			.note-two { right: 8%; bottom: 11%; }
			.visual-caption { position: absolute; right: -10px; bottom: 6%; margin: 0; writing-mode: vertical-rl; transform: translateX(100%); color: var(--muted); font-size: .65rem; letter-spacing: .18em; text-transform: uppercase; }
			.scroll-cue { position: absolute; left: max(24px, calc((100vw - 1220px) / 2)); bottom: 40px; display: flex; gap: 22px; align-items: center; color: var(--muted); font-size: .65rem; letter-spacing: .18em; text-transform: uppercase; }

			.section-shell { width: var(--shell); margin-inline: auto; }
			.section-number { color: #727278; font-size: .64rem; letter-spacing: .18em; text-transform: uppercase; }
			.manifesto { padding: 140px 0 150px; display: grid; grid-template-columns: 170px 1fr .65fr; gap: 6vw; align-items: end; border-top: 1px solid var(--track); }
			.manifesto h2 { font-size: clamp(3.4rem, 6vw, 6.5rem); }
			.manifesto h2 span { color: var(--gold); }
			.manifesto-body { max-width: 420px; margin: 0; color: var(--text-soft); font-size: 1rem; line-height: 1.85; }

			.effect-section { padding-bottom: 150px; }
			.effect-card { display: grid; grid-template-columns: 1.08fr .92fr; min-height: 650px; background: var(--surface); border: 1px solid var(--outline); border-radius: var(--radius); overflow: hidden; }
			.effect-demo { position: relative; display: grid; place-items: center; min-height: 590px; overflow: hidden; background: radial-gradient(circle, #302719 0, #181716 44%, #121213 72%); }
			.demo-spiral { position: relative; z-index: 2; width: min(60%, 370px); overflow: visible; }
			.demo-spiral path, .contact-spiral path { fill: none; stroke: var(--gold); stroke-width: 12; stroke-linecap: round; filter: drop-shadow(0 0 8px #ffad1f) drop-shadow(0 0 20px rgba(255,171,31,.65)); stroke-dasharray: 930; stroke-dashoffset: 0; transition: stroke-width .55s ease, filter .55s ease, stroke-dashoffset .85s ease; }
			.demo-halo { position: absolute; border-radius: 50%; border: 1px solid rgba(255,198,66,.14); transition: opacity .55s ease, transform .55s ease; }
			.halo-one { width: 46%; aspect-ratio: 1; box-shadow: 0 0 60px rgba(255,171,31,.14); }
			.halo-two { width: 64%; aspect-ratio: 1; }
			.halo-three { width: 82%; aspect-ratio: 1; }
			.effect-demo[data-mode="filament"] .demo-spiral path { stroke-width: 7; stroke-dashoffset: 210; animation: draw 1.3s ease forwards; }
			.effect-demo[data-mode="filament"] .demo-halo { opacity: .15; transform: scale(.82); }
			.effect-demo[data-mode="halo"] .demo-spiral path { filter: drop-shadow(0 0 9px #ffad1f) drop-shadow(0 0 32px #ffad1f) drop-shadow(0 0 60px rgba(255,171,31,.6)); }
			.effect-demo[data-mode="halo"] .demo-halo { animation: breathe 2.4s ease-in-out infinite; }
			.demo-label { position: absolute; left: 28px; bottom: 24px; color: var(--muted); font-size: .6rem; letter-spacing: .18em; }
			.effect-copy { padding: clamp(50px, 7vw, 100px); display: flex; flex-direction: column; justify-content: center; }
			.effect-copy h2 { font-size: clamp(3.7rem, 6vw, 6.2rem); }
			.effect-copy > p:not(.eyebrow) { margin: 34px 0 44px; color: var(--text-soft); line-height: 1.8; max-width: 470px; min-height: 88px; }
			.effect-tabs { display: flex; border-top: 1px solid var(--outline); }
			.effect-tab { flex: 1; display: flex; flex-direction: column; gap: 4px; padding: 18px 6px; background: none; color: var(--muted); border: 0; border-bottom: 2px solid var(--outline); cursor: pointer; font-size: .62rem; text-align: left; transition: color .2s ease, border-color .2s ease; }
			.effect-tab span { font-size: .74rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
			.effect-tab.is-active { color: var(--gold); border-color: var(--gold); }

			.gallery-section { padding: 20px 0 160px; }
			.gallery-heading { display: flex; justify-content: space-between; align-items: end; gap: 40px; margin-bottom: 64px; }
			.gallery-heading .section-number { margin-bottom: 30px; }
			.gallery-heading h2 { font-size: clamp(4rem, 7vw, 7.2rem); }
			.gallery-heading > p { max-width: 340px; margin: 0 0 10px; color: var(--text-soft); line-height: 1.75; }
			.gallery-grid { display: grid; grid-template-columns: 1.25fr .75fr; gap: 20px; }
			.gallery-side { display: grid; gap: 20px; }
			.gallery-item { position: relative; margin: 0; overflow: hidden; border-radius: 18px; background: var(--surface); }
			.gallery-item::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 65%, rgba(0,0,0,.68)); pointer-events: none; }
			.gallery-item img, .gallery-item video { height: 100%; object-fit: cover; transition: transform .8s cubic-bezier(.2,.75,.3,1); }
			.gallery-item:hover img, .gallery-item:hover video { transform: scale(1.025); }
			.gallery-main { min-height: 830px; }
			.gallery-main img { object-position: 50% center; }
			.gallery-side .gallery-item { min-height: 405px; }
			.gallery-side .gallery-item:first-child img { object-position: 50% 42%; }
			.gallery-item figcaption { position: absolute; z-index: 3; left: 22px; right: 22px; bottom: 20px; display: flex; justify-content: space-between; font-size: .65rem; letter-spacing: .14em; text-transform: uppercase; }
			.video-item { isolation: isolate; }
			.video-item video { position: absolute; inset: 0; z-index: 1; opacity: 0; transition: opacity .35s ease, transform .8s cubic-bezier(.2,.75,.3,1); }
			.video-item video.is-ready { opacity: 1; }
			.video-toggle { position: absolute; z-index: 4; inset: 50% auto auto 50%; translate: -50% -50%; width: 66px; height: 66px; display: grid; place-items: center; border: 1px solid rgba(255,255,255,.5); border-radius: 50%; background: rgba(15,15,16,.5); backdrop-filter: blur(8px); color: #fff; cursor: pointer; }
			.pause-icon, .video-toggle.is-playing .play-icon { display: none; }
			.video-toggle.is-playing .pause-icon { display: inline; }

			.contact-section { position: relative; min-height: 610px; margin-bottom: 28px; display: grid; place-items: center; overflow: hidden; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--outline); text-align: center; isolation: isolate; }
			.contact-section::before { content: ''; position: absolute; inset: 0; background: linear-gradient(120deg, rgba(255,255,255,.025), transparent 55%); z-index: -1; }
			.contact-glow { position: absolute; width: 460px; height: 460px; border-radius: 50%; background: rgba(255,183,39,.16); filter: blur(100px); z-index: -1; }
			.contact-content { padding: 80px 24px; display: flex; flex-direction: column; align-items: center; }
			.contact-content h2 { font-size: clamp(4.2rem, 8vw, 8rem); }
			.contact-content > p:not(.eyebrow) { max-width: 500px; margin: 30px 0 34px; color: var(--text-soft); }
			.button-large { min-height: 60px; padding-inline: 30px; }
			.contact-spiral { position: absolute; right: -90px; bottom: -130px; width: 420px; opacity: .12; z-index: -1; rotate: 12deg; }
			.contact-spiral path { stroke-width: 9; }

			.site-footer { min-height: 150px; display: grid; grid-template-columns: 1fr 1fr 1fr; align-items: center; color: var(--muted); font-size: .7rem; letter-spacing: .08em; text-transform: uppercase; }
			.site-footer > p { margin: 0; text-align: center; }
			.site-footer .copyright { text-align: right; }
			.reveal { opacity: 1; transform: none; }
			.js .reveal { opacity: 0; transform: translateY(22px); transition: opacity .7s ease var(--delay, 0ms), transform .7s ease var(--delay, 0ms); }
			.js .reveal.is-visible { opacity: 1; transform: translateY(0); }

			@keyframes rotate { to { transform: rotate(348deg); } }
			@keyframes draw { from { stroke-dashoffset: 620; } to { stroke-dashoffset: 210; } }
			@keyframes breathe { 50% { transform: scale(1.07); opacity: .45; } }

			@media (max-width: 900px) {
				:root { --shell: min(100% - 36px, 720px); }
				.hero { height: auto; min-height: 900px; grid-template-columns: 1fr 1fr; gap: 2vw; padding-inline: 18px; }
				.hero-visual { width: 48vw; }
				.manifesto { grid-template-columns: 90px 1fr; }
				.manifesto-body { grid-column: 2; }
				.effect-card { grid-template-columns: 1fr; }
				.effect-demo { min-height: 520px; }
				.gallery-main { min-height: 690px; }
				.gallery-side .gallery-item { min-height: 335px; }
			}

			@media (max-width: 720px) {
				:root { --shell: calc(100% - 28px); --radius: 22px; }
				.site-header { height: 74px; }
				.site-header .brand { position: relative; z-index: 12; }
				.menu-toggle { position: relative; z-index: 12; width: 44px; height: 44px; display: grid; place-content: center; gap: 7px; padding: 0; border: 1px solid var(--outline); border-radius: 50%; background: rgba(15,15,16,.75); }
				.menu-toggle span:not(.sr-only) { display: block; width: 17px; height: 1px; background: #fff; transition: transform .2s ease; }
				.menu-toggle[aria-expanded="true"] span:nth-child(2) { transform: translateY(4px) rotate(45deg); }
				.menu-toggle[aria-expanded="true"] span:nth-child(3) { transform: translateY(-4px) rotate(-45deg); }
				.site-nav { position: fixed; inset: 0; display: flex; flex-direction: column; justify-content: center; gap: 30px; background: rgba(15,15,16,.97); opacity: 0; pointer-events: none; transition: opacity .2s ease; }
				.site-nav a { font-size: 1rem; }
				.site-nav.is-open { opacity: 1; pointer-events: auto; }
				.hero { display: flex; flex-direction: column; align-items: stretch; padding: 112px 14px 80px; min-height: auto; }
				.hero::before { width: 100%; }
				.hero-copy { padding: 0; }
				h1 { font-size: clamp(4.5rem, 23vw, 7rem); }
				.hero-intro { margin-top: 26px; }
				.hero-actions { align-items: flex-start; flex-direction: column; gap: 13px; margin-top: 30px; }
				.hero-visual { width: 100%; margin-top: 64px; }
				.hero-frame { aspect-ratio: .82; border-radius: 44% 44% 18% 18% / 28% 28% 15% 15%; }
				.visual-caption { display: none; }
				.scroll-cue { display: none; }
				.manifesto { padding: 95px 0; display: block; }
				.manifesto .section-number { margin-bottom: 52px; }
				.manifesto h2 { font-size: 3.55rem; }
				.manifesto-body { margin-top: 34px; }
				.effect-section { padding-bottom: 100px; }
				.effect-card { min-height: 0; }
				.effect-demo { min-height: 430px; }
				.demo-spiral { width: 68%; }
				.effect-copy { padding: 54px 24px 40px; }
				.effect-copy h2 { font-size: 3.8rem; }
				.effect-tabs { margin-inline: -4px; }
				.gallery-section { padding-bottom: 100px; }
				.gallery-heading { display: block; margin-bottom: 42px; }
				.gallery-heading h2 { font-size: 4.1rem; }
				.gallery-heading > p { margin-top: 30px; }
				.gallery-grid { grid-template-columns: 1fr; }
				.gallery-main { min-height: 620px; }
				.gallery-side .gallery-item { min-height: 430px; }
				.contact-section { width: calc(100% - 20px); min-height: 600px; }
				.contact-content h2 { font-size: 4.4rem; }
				.site-footer { min-height: 220px; grid-template-columns: 1fr 1fr; gap: 20px; }
				.site-footer > p:nth-of-type(1) { display: none; }
				.site-footer .copyright { text-align: right; }
			}

			@media (prefers-reduced-motion: reduce) {
				html { scroll-behavior: auto; }
				*, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
				.reveal { opacity: 1; transform: none; }
			}
		</style>
	</body>
